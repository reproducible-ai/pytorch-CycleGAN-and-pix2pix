#Ignore Wandb
wandb/

# roar state — the generated setup stage runs `roar init`, which creates
# .roar/. Without this rule the worktree goes dirty and the FIRST PAID
# `roar run` refuses to execute ("Run blocked: untracked files").
.roar/
# --- reproduction outputs (scaffold_row.py: mnist rule) ---
# file-pattern ignore + tracked .gitkeep so each dir survives a clean
# checkout and roar keeps the outputs in lineage. NEVER dir-ignore.
!datasets/facades/
datasets/facades/*
!datasets/facades/.gitkeep
!datasets/facades/train/
datasets/facades/train/*
!datasets/facades/train/.gitkeep
!datasets/facades/test/
datasets/facades/test/*
!datasets/facades/test/.gitkeep
!datasets/facades/val/
datasets/facades/val/*
!datasets/facades/val/.gitkeep
!checkpoints/facades_pix2pix/
checkpoints/facades_pix2pix/*
!checkpoints/facades_pix2pix/.gitkeep
!checkpoints/facades_pix2pix/web/
checkpoints/facades_pix2pix/web/*
!checkpoints/facades_pix2pix/web/.gitkeep
!checkpoints/facades_pix2pix/web/images/
checkpoints/facades_pix2pix/web/images/*
!checkpoints/facades_pix2pix/web/images/.gitkeep
